{
	"name": "partyplayback",
	"routes": [{ "pattern": "youple.tv", "custom_domain": true }],
	"workers_dev": false,
	"keep_vars": true,
	"preview_urls": false,
	"compatibility_date": "2025-10-08",
	"compatibility_flags": ["nodejs_compat"],
	"main": "./dist/_worker.js/index.js",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"durable_objects": {
		"bindings": [
			{ "name": "ROOM", "class_name": "RoomDO" }
		]
	},
	"ratelimits": [
		{ "name": "CONTACT_LIMIT", "namespace_id": "1001", "simple": { "limit": 3, "period": 60 } }
	],
	"migrations": [
		{ "tag": "v1", "new_sqlite_classes": ["RoomDO"] }
	],
	"vars": {
		"TAB_SHARING_ENABLED": "false",
		"SUPABASE_URL": "https://bracoxtbzzparrntdvsn.supabase.co",
		"SUPABASE_PUBLISHABLE_KEY": "sb_publishable_iShn05j5EWc691bB78awsw_gTFLN8d1"
	}
}
