# Copy to .dev.vars for local preview. Set the same values in the Cloudflare
# dashboard for production. Never use a service-role key here.
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_YOUR_KEY"
# Local preview only: where Google, Discord and email links send you back.
AUTH_REDIRECT_ORIGIN="http://localhost:8787"
# Contact and bug report forms: a Resend API key with sending access to youple.tv.
RESEND_API_KEY="re_YOUR_KEY"
# Optional Cloudflare Realtime TURN relay for tab sharing across restrictive networks.
# Set both as Worker secrets in production. Only temporary credentials reach viewers.
# TURN_KEY_ID="YOUR_TURN_KEY_ID"
# TURN_KEY_API_TOKEN="YOUR_TURN_KEY_API_TOKEN"
