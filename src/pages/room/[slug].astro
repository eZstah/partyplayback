---
import Icon from '../../components/Icon.astro';
import Mascot from '../../components/Mascot.astro';
import AuthDialog from '../../components/AuthDialog.astro';
import Wordmark from '../../components/Wordmark.astro';
import '../../styles/app.css';
import '../../styles/room.css';
import { verifiedUser, displayName } from '../../lib/auth';
import { roomDetails } from '../../lib/rooms';
const { slug } = Astro.params;
if (!slug || !/^[a-zA-Z0-9_-]{1,64}$/.test(slug)) return Astro.redirect('/');
const details = await roomDetails(Astro.locals.runtime.env, slug);
if (slug.startsWith('m-') && !details) return Astro.redirect('/');
const user = await verifiedUser(Astro);
if (details?.mode === 'member' && !user) return Astro.redirect('/?signin=1&next=' + encodeURIComponent('/room/' + slug));
const title = details?.title || slug;
const configured = !!Astro.locals.runtime.env.SUPABASE_URL && !!Astro.locals.runtime.env.SUPABASE_PUBLISHABLE_KEY;
Astro.response.headers.set('Cache-Control', 'private, no-store');
---
<!doctype html>
<html lang="en">
<head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="theme-color" content="#181622"/><title>{title} — youple.tv</title><link rel="icon" href="/favicon.svg" type="image/svg+xml"/></head>
<body class="room-page" data-playback="idle" data-room={slug} data-user-name={user ? displayName(user) : ''}>
  <div class="room-atmosphere" aria-hidden="true"><span class="room-glow"></span><span class="room-doodle room-note"><svg viewBox="0 0 32 44" fill="none"><path d="M17 33V5c0 11 15 6 10 19" stroke="currentColor" stroke-width="4" stroke-linecap="round"/><ellipse cx="10" cy="34" rx="8" ry="5" fill="currentColor" transform="rotate(-20 10 34)"/></svg></span><span class="room-doodle room-sound"><svg viewBox="0 0 40 40" fill="none"><path d="M7 26v-9m9 16V8m9 22V12m9 12v-6" stroke="currentColor" stroke-width="4" stroke-linecap="round"/></svg></span><span class="room-orbit"></span><i class="room-dot"></i></div>
  <div id="room-shell" class="room-shell">
  <header class="room-nav">
    <div class="room-identity"><a class="room-wordmark-link" href="/" aria-label="youple.tv home"><Wordmark/></a><div class="room-name"><h1 title={title}>{title}</h1>{details?.mode !== 'member' && (user ? <a class="own-room-button" href="/?create=member" title="Create a permanent room"><Icon name="spark" size={16}/>Your own room</a> : <button class="own-room-button" id="own-room-btn" type="button" title="Sign in to create a permanent room"><Icon name="spark" size={16}/>Your own room</button>)}</div></div>
    <div class="room-tools"><div class="room-presence"><span id="conn" class="connecting" role="status">Connecting</span><span id="uc">Joining…</span><button id="uname" class="name-button" type="button" disabled={!!user} title={user ? 'Signed in' : 'Change your name'}>Guest</button></div><button id="invite-btn" class="soft-button header-invite" type="button" aria-label="Invite friends" title="Copy room link"><span id="invite-icon"><Icon name="link" size={20}/></span><span id="invite-success-icon" hidden><Icon name="check" size={20}/></span><span id="invite-label">Invite friends</span></button><div class="header-view-controls" role="group" aria-label="Viewing mode"><button id="theater-btn" class="icon-button" type="button" aria-label="Theater mode" aria-pressed="false" aria-keyshortcuts="T" title="Theater mode (T)"><Icon name="theater"/></button><button id="fullscreen-btn" class="icon-button" type="button" aria-label="Fullscreen" aria-pressed="false" aria-keyshortcuts="F" title="Fullscreen (F)"><Icon name="fullscreen"/></button></div></div>
  </header>
  <main class="watch-layout reveal">
    <section class="watch-column" aria-label="Watch together">
      <div class="room-pal player-pal" aria-hidden="true"><Mascot kind="mint"/></div>
      <div id="stage" class="stage">
        <div id="player-wrap"><div id="yt-player"></div><div id="placeholder"><span class="empty-play"><Icon name="play" size={36}/></span><h2>The room is yours.</h2><p>Paste a video link to get things started.</p><button id="first-video-btn" class="primary-button" type="button"><Icon name="plus" size={18}/>Add the first video</button></div></div>
        <div class="player-bottom">
          <div class="timeline"><span id="elapsed">0:00</span><input id="progress" type="range" min="0" max="1" step="0.1" value="0" aria-label="Seek video" disabled/><span id="duration">0:00</span></div>
          <div id="playback-controls" class="control-bar" aria-label="Room playback controls">
            <div class="transport"><button id="play-btn" class="play-control" type="button" aria-label="Play" aria-keyshortcuts="Space K" disabled><span id="play-icon"><Icon name="play" size={26}/></span><span id="pause-icon" hidden><Icon name="pause" size={26}/></span><span id="play-label">Play</span><kbd class="control-key" aria-hidden="true">Space</kbd></button><button id="next-btn" class="next-control" type="button" aria-label="Next video" aria-keyshortcuts="N" title="Next video (N)" disabled><Icon name="next" size={23}/><span>Next</span><kbd class="control-key" aria-hidden="true">N</kbd></button><button id="enable-btn" class="soft-button" type="button" hidden>Join playback</button></div>
            <div class="view-controls"><button id="mute-btn" class="sound-control" type="button" aria-label="Mute" title="Mute on your device (M)" aria-keyshortcuts="M" disabled><span id="mute-icon"><Icon name="mute"/></span><span id="unmute-icon" hidden><Icon name="sound"/></span><span id="mute-label">Mute</span><kbd class="control-key" aria-hidden="true">M</kbd></button><button id="help-btn" class="icon-button shortcuts-control" type="button" aria-label="Keyboard shortcuts" aria-keyshortcuts="?" title="All keyboard shortcuts (?)"><Icon name="key" size={20}/><span class="help-label">Shortcuts</span></button></div>
          </div>
        </div>
      </div>
      <span class="sr-only" id="playing-status" role="status">No video selected.</span>
    </section>
    <div class="playlist-column"><div class="room-pal playlist-pal" aria-hidden="true"><Mascot kind="pink"/></div><aside id="sidebar" class="playlist-panel" aria-label="Playlist"><div class="playlist-heading"><h2>Up next<span id="queue-count">00</span></h2></div><form id="add-form"><label class="sr-only" for="url-in">YouTube video URL</label><input id="url-in" type="url" placeholder="Paste a YouTube link" autocomplete="off" required/><button id="add-btn" type="submit" class="icon-button" aria-label="Add to playlist" title="Add to playlist"><Icon name="plus" size={22}/></button></form><ul id="q-list"></ul><div id="queue-empty"><Icon name="playlist" size={28}/><span class="sr-only">Your playlist is empty.</span></div></aside></div>
  </main>
  <dialog id="name-dialog" class="dialog" aria-labelledby="name-heading"><button class="dialog-close" data-close-dialog type="button" aria-label="Close"><Icon name="close" size={16}/></button><h2 id="name-heading">What should we call you?</h2><form id="name-form"><label for="guest-name">Your name</label><input id="guest-name" required maxlength="32" autocomplete="nickname"/><button class="primary-button wide" type="submit">That's me</button></form></dialog>
  <dialog id="help-dialog" class="dialog" aria-labelledby="help-heading"><button class="dialog-close" data-close-dialog type="button" aria-label="Close"><Icon name="close" size={16}/></button><h2 id="help-heading">Keyboard shortcuts</h2><div class="shortcut-table"><div><span>Play / pause</span><span><kbd>Space</kbd> <kbd>K</kbd></span></div><div><span>Seek 5 seconds</span><span><kbd>Left</kbd> <kbd>Right</kbd></span></div><div><span>Seek 10 seconds</span><span><kbd>J</kbd> <kbd>L</kbd></span></div><div><span>Next video</span><kbd>N</kbd></div><div><span>Fullscreen</span><kbd>F</kbd></div><div><span>Theater mode</span><kbd>T</kbd></div><div><span>Mute / unmute on your device</span><kbd>M</kbd></div></div><p>Shortcuts take a break while you're typing. Press Esc to close this window or leave fullscreen.</p></dialog>
  <AuthDialog configured={configured} heading="Your own room" description="Sign in to create a permanent room."/>
  <div id="toast" class="toast" role="status"></div>
  </div>
  <script>import { revealCreatedRoom } from '../../scripts/room-transition.js'; import { bootRoom } from '../../scripts/room-client.js'; revealCreatedRoom(); bootRoom(document.body.dataset.room);</script>
</body></html>
