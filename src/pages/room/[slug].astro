---
import Icon from '../../components/Icon.astro';
import Mascot from '../../components/Mascot.astro';
import CatUniverse from '../../components/CatUniverse.astro';
import Wordmark from '../../components/Wordmark.astro';
import PortalArrival from '../../components/PortalArrival.astro';
import '../../styles/app.css';
import '../../styles/room.css';
import '../../styles/tab-sharing.css';
import { verifiedUser, displayName } from '../../lib/auth';
import { roomDetails } from '../../lib/rooms';
const { slug } = Astro.params;
if (!slug || !/^[a-zA-Z0-9_-]{1,64}$/.test(slug)) return Astro.redirect('/');
const details = await roomDetails(Astro.locals.runtime.env, slug);
if (slug.startsWith('m-') && !details) return Astro.redirect('/');
const user = await verifiedUser(Astro);
if (details?.mode === 'member' && !user) return Astro.redirect('/?signin=1&next=' + encodeURIComponent('/room/' + slug));
const title = details?.title || slug;
Astro.response.headers.set('Cache-Control', 'private, no-store');
---
<!doctype html>
<html lang="en">
<head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="theme-color" content="#181622"/><title>{title} — youple.tv</title><link rel="icon" href="/favicon.svg" type="image/svg+xml"/><PortalArrival/></head>
<body class="room-page" data-playback="idle" data-room={slug} data-user-name={user ? displayName(user) : ''}>
  <script is:inline>
    try {
      const touchLayout = matchMedia("(max-width:600px), (max-width:900px) and (pointer:coarse)").matches;
      if (!touchLayout && localStorage.getItem("youple-theater") === "true") document.body.classList.add("theater");
      if (localStorage.getItem("youple-people") === "true") document.body.classList.add("people-open");
    } catch {}
  </script>
  <div class="room-atmosphere" aria-hidden="true"><span class="room-glow"></span><span class="room-doodle room-note"><svg viewBox="0 0 32 44" fill="none"><path d="M17 33V5c0 11 15 6 10 19" stroke="currentColor" stroke-width="4" stroke-linecap="round"/><ellipse cx="10" cy="34" rx="8" ry="5" fill="currentColor" transform="rotate(-20 10 34)"/></svg></span><span class="room-doodle room-sound"><svg viewBox="0 0 40 40" fill="none"><path d="M7 26v-9m9 16V8m9 22V12m9 12v-6" stroke="currentColor" stroke-width="4" stroke-linecap="round"/></svg></span><span class="room-orbit"></span><i class="room-dot"></i></div>
  <div id="room-shell" class="room-shell" tabindex="-1">
  <header class="room-nav">
    <div class="room-identity"><a class="room-wordmark-link" href="/" aria-label="youple.tv home"><Wordmark/></a><div class="room-name"><h1 title={title}>{title}</h1><button id="invite-btn" class="header-invite" type="button" aria-label="Invite friends" title="Copy room link"><span id="invite-icon"><Icon name="link" size={17}/></span><span id="invite-success-icon" hidden><Icon name="check" size={17}/></span><span id="invite-label">Invite friends</span></button></div></div>
    <div class="room-tools"><div class="room-presence"><span id="conn" class="connecting" role="status">Connecting</span><button id="uc" class="facepile" type="button" aria-controls="room-people" aria-expanded="false"><span class="facepile-faces" aria-hidden="true"></span><span id="uc-label">Joining…</span></button><button id="uname" class="name-button" type="button" disabled={!!user} title={user ? 'Signed in' : 'Change your name'}><span id="uname-face" class="name-face" aria-hidden="true"></span><span id="uname-label" class="name-label">Guest</span></button></div><button id="help-btn" class="icon-button header-shortcuts" type="button" aria-label="Keyboard shortcuts" aria-keyshortcuts="?" title="Keyboard shortcuts (?)"><Icon name="key" size={20}/></button></div>
  </header>
  <main class="watch-layout">
    <section class="watch-column" aria-label="Watch together">
      <div class="share-bar">
        <div class="share-copy"><strong id="share-heading">Watch anything together</strong><p id="share-hint" role="status">TikToks, Reels, Shorts — share a tab with sound.</p><p id="share-audio-note" hidden>No tab audio is being shared. To include sound, stop and select Share tab audio.</p></div>
        <div class="share-actions"><button id="share-start-btn" class="soft-button" type="button" disabled><Icon name="screen" size={18}/>Share a tab</button><button id="share-retry-btn" class="soft-button" type="button" hidden>Reconnect</button><button id="share-fullscreen-btn" class="icon-button" type="button" aria-label="Fullscreen shared tab" title="Fullscreen" hidden><Icon name="fullscreen"/></button><button id="share-stop-btn" class="soft-button share-stop" type="button" hidden>Stop sharing</button></div>
      </div>
      <div id="stage" class="stage">
        <div id="shared-screen" class="shared-screen" hidden>
          <video id="shared-video" autoplay playsinline aria-label="Shared browser tab"></video>
          <div id="share-message" class="share-message"><Icon name="screen" size={36}/><p id="share-message-text" role="status">Connecting to the shared tab…</p><button id="share-join-btn" class="primary-button" type="button" hidden>Join shared tab</button></div>
        </div>
        <div id="player-wrap"><div id="yt-player"></div><div id="playback-overlay" class="playback-overlay" aria-hidden="true"><span class="overlay-disc"><svg class="overlay-play" viewBox="0 0 48 48"><path d="M17 11.5v25a2 2 0 0 0 3 1.7l20-12.5a2 2 0 0 0 0-3.4L20 9.8a2 2 0 0 0-3 1.7Z"/></svg><svg class="overlay-pause" viewBox="0 0 48 48"><rect x="12" y="10" width="8.5" height="28" rx="2.5"/><rect x="27.5" y="10" width="8.5" height="28" rx="2.5"/></svg><svg class="overlay-muted" viewBox="0 0 48 48"><path d="M8 18h7l10-8v28l-10-8H8z"/><path d="m31 18 12 12m0-12L31 30" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round"/></svg><svg class="overlay-unmuted" viewBox="0 0 48 48"><path d="M6 18h7l10-8v28l-10-8H6z"/><path d="M30 17a9 9 0 0 1 0 14m5-20a17 17 0 0 1 0 26" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round"/></svg></span><span id="overlay-caption" class="overlay-caption"></span></div><div id="placeholder"><div class="room-pal player-pal"><div class="pal-peek"><Mascot kind="black"/></div></div><h2>The room is yours.</h2><p>Paste a video link to get things started.</p><button id="first-video-btn" class="primary-button" type="button"><Icon name="plus" size={18}/>Add the first video</button></div><div class="fullscreen-wake" aria-hidden="true"></div></div>
        <div class="player-bottom">
          <div class="timeline"><span id="elapsed">0:00</span><input id="progress" type="range" min="0" max="1" step="0.1" value="0" aria-label="Seek video" disabled/><span id="duration">0:00</span></div>
          <div id="playback-controls" class="control-bar" aria-label="Room playback controls">
            <div class="transport"><button id="play-btn" class="play-control" type="button" aria-label="Play" aria-keyshortcuts="Space K" disabled><span id="play-icon"><Icon name="play" size={26}/></span><span id="pause-icon" hidden><Icon name="pause" size={26}/></span><span id="play-label">Play</span><kbd class="control-key" aria-hidden="true">Space</kbd></button><button id="next-btn" class="next-control" type="button" aria-label="Next video" aria-keyshortcuts="N" title="Next video (N)" disabled><Icon name="next" size={23}/><span>Next</span><kbd class="control-key" aria-hidden="true">N</kbd></button><button id="enable-btn" class="soft-button" type="button" hidden>Join playback</button></div>
            <div class="view-controls"><div class="volume-control" role="group" aria-label="Sound on your device"><button id="mute-btn" class="sound-control" type="button" aria-label="Mute" title="Mute on your device (M)" aria-keyshortcuts="M" disabled><span id="mute-icon"><Icon name="mute"/></span><span id="unmute-icon" hidden><Icon name="sound"/></span><span id="mute-label">Mute</span><kbd class="control-key" aria-hidden="true">M</kbd></button><input id="volume" class="volume-slider" type="range" min="0" max="100" step="1" value="100" aria-label="Volume" aria-valuetext="100%" title="Volume on your device" disabled/><span id="device-volume-hint" class="device-volume-hint" hidden>Device volume</span></div><div class="player-view-controls" role="group" aria-label="Viewing mode"><button id="skip-btn" class="icon-button skip-button" type="button" aria-haspopup="dialog" aria-label="Skip sponsors" title="Skip sponsors" data-on="true" disabled><Icon name="skip"/></button><button id="youtube-controls-btn" class="icon-button" type="button" aria-label="Subtitles and quality" aria-pressed="false" title="Show subtitles and quality controls" disabled><Icon name="settings"/></button><button id="theater-btn" class="icon-button" type="button" aria-label="Theater mode" aria-pressed="false" aria-keyshortcuts="T" title="Theater mode (T)"><Icon name="theater"/></button><button id="fullscreen-btn" class="icon-button" type="button" aria-label="Fullscreen" aria-pressed="false" aria-keyshortcuts="F" title="Fullscreen (F)"><Icon name="fullscreen"/></button></div></div>
          </div>
        </div>
      </div>
      <span class="sr-only" id="playing-status" role="status">No video selected.</span>
    </section>
    <div class="playlist-column"><aside id="sidebar" class="playlist-panel" aria-label="Room"><section id="room-people" class="room-people" aria-labelledby="people-heading"><h2 id="people-heading">Watching<span id="people-count">00</span></h2><ul id="people-list"></ul></section><div class="playlist-heading"><h2 id="playlist-heading">Playlist<span id="queue-count">00</span></h2><button id="auto-clear-btn" class="auto-clear-toggle" type="button" role="switch" aria-checked="false" title="Remove videos when skipped or finished" aria-describedby="auto-clear-description" disabled>Auto-clear<span class="auto-clear-track" aria-hidden="true"></span></button><span id="auto-clear-description" class="sr-only">Remove videos from the room playlist when skipped or finished.</span></div><form id="add-form" novalidate><label class="sr-only" for="url-in">YouTube video URL</label><input id="url-in" type="url" aria-describedby="add-error" aria-invalid="false" placeholder="Paste a YouTube link" autocomplete="off" required/><button id="add-btn" type="button" class="icon-button" aria-label="Add to playlist" title="Add a link or paste from clipboard"><Icon name="plus" size={22}/></button></form><div id="add-feedback" class="playlist-add-feedback" hidden><p id="add-error" class="playlist-add-message" role="alert"></p></div><ul id="q-list"></ul><div id="queue-empty"><Icon name="playlist" size={28}/><span class="sr-only">Your playlist is empty.</span></div></aside></div>
  </main>
  <dialog id="name-dialog" class="dialog" aria-labelledby="name-heading"><button class="dialog-close" data-close-dialog type="button" aria-label="Close"><Icon name="close" size={16}/></button><h2 id="name-heading">What should we call you?</h2><form id="name-form"><label for="guest-name">Your name</label><input id="guest-name" required maxlength="32" autocomplete="nickname"/><button class="primary-button wide" type="submit">That's me</button></form></dialog>
  <dialog id="share-dialog" class="dialog share-dialog" aria-labelledby="share-dialog-heading"><button class="dialog-close" data-close-dialog type="button" aria-label="Close"><Icon name="close" size={16}/></button><Icon name="screen" size={32}/><h2 id="share-dialog-heading">Bring your feed along.</h2><p>Open TikTok, Instagram or Shorts in another browser tab. Choose it in the next window and turn on <strong>Share tab audio</strong>.</p><p>Everyone in this room will see that tab as you scroll. Your YouTube playlist will pause until you’re done.</p><button id="share-confirm-btn" class="primary-button wide" type="button">Choose a tab</button><p class="share-dialog-footnote">Best in desktop Chrome or Edge. Up to four viewers.</p></dialog>
  <dialog id="help-dialog" class="dialog" aria-labelledby="help-heading"><button class="dialog-close" data-close-dialog type="button" aria-label="Close"><Icon name="close" size={16}/></button><h2 id="help-heading">Keyboard shortcuts</h2><div class="shortcut-table"><div><span>Play / pause</span><span><kbd>Space</kbd> <kbd>K</kbd></span></div><div><span>Seek 5 seconds</span><span><kbd>Left</kbd> <kbd>Right</kbd></span></div><div><span>Seek 10 seconds</span><span><kbd>J</kbd> <kbd>L</kbd></span></div><div><span>Next video</span><kbd>N</kbd></div><div><span>Fullscreen</span><kbd>F</kbd></div><div><span>Theater mode</span><kbd>T</kbd></div><div><span>Mute / unmute on your device</span><kbd>M</kbd></div></div><p>Shortcuts take a break while you're typing. Press Esc to close this window or leave fullscreen.</p></dialog>
  <dialog id="skip-dialog" class="dialog skip-dialog" aria-labelledby="skip-heading"><button class="dialog-close" data-close-dialog type="button" aria-label="Close"><Icon name="close" size={16}/></button><h2 id="skip-heading">Skip sponsors</h2><p>Jumps over sponsor reads and similar parts for everyone in the room at once, using community data from <a href="https://sponsor.ajay.app/" target="_blank" rel="noopener">SponsorBlock</a>.</p><button id="skip-toggle" class="auto-clear-toggle skip-toggle" type="button" role="switch" aria-checked="true">Skip for everyone<span class="auto-clear-track" aria-hidden="true"></span></button><fieldset id="skip-categories" class="skip-categories"><legend class="sr-only">What to skip</legend><label class="skip-option"><input type="checkbox" value="sponsor"/><span>Sponsors</span></label><label class="skip-option"><input type="checkbox" value="selfpromo"/><span>Self-promotion</span></label><label class="skip-option"><input type="checkbox" value="interaction"/><span>Like and subscribe reminders</span></label><label class="skip-option"><input type="checkbox" value="intro"/><span>Intros</span></label><label class="skip-option"><input type="checkbox" value="outro"/><span>Endcards and credits</span></label><label class="skip-option"><input type="checkbox" value="preview"/><span>Previews and recaps</span></label><label class="skip-option"><input type="checkbox" value="music_offtopic"/><span>Non-music parts of music videos</span></label><label class="skip-option"><input type="checkbox" value="filler"/><span>Tangents and filler</span></label></fieldset></dialog>
  <div id="toast" class="toast" role="status"></div><div id="copied-pop" class="copied-pop" role="status"><span class="copied-pop-card"><span class="copied-pop-check" aria-hidden="true"><svg viewBox="0 0 48 48"><path d="m13 25 7 7 15-16" fill="none" stroke="currentColor" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"/></svg></span><strong id="copied-pop-title"></strong><span id="copied-pop-text"></span></span></div>
  </div>
  <script>import { revealCreatedRoom } from '../../scripts/room-transition.js'; import { bootRoom } from '../../scripts/room-client.js'; const arrival = revealCreatedRoom(); bootRoom(document.body.dataset.room, arrival);</script>
  <CatUniverse/>
</body></html>
