---
import Icon from '../components/Icon.astro';
import PortalIcon from '../components/PortalIcon.astro';
import Mascot from '../components/Mascot.astro';
import MusicFlourishes from '../components/MusicFlourishes.astro';
import AuthDialog from '../components/AuthDialog.astro';
import Wordmark from '../components/Wordmark.astro';
import '../styles/app.css';
import '../styles/home.css';
import { verifiedUser, displayName } from '../lib/auth';
import { ownedRooms } from '../lib/rooms';
import { illustrativeSyncCount } from '../lib/activity.js';
const user = await verifiedUser(Astro);
const name = user ? displayName(user) : null;
const configured = !!Astro.locals.runtime.env.SUPABASE_URL && !!Astro.locals.runtime.env.SUPABASE_PUBLISHABLE_KEY;
const rooms = user ? await ownedRooms(Astro.locals.runtime.env, user.id) : [];
Astro.response.headers.set('Cache-Control', 'private, no-store');
---
<!doctype html>
<html lang="en">
<head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="description" content="Watch YouTube with your friends. Create a room, share the link, and press play together on youple.tv."/><meta name="theme-color" content="#181622"/><title>youple.tv — Watch YouTube together</title><link rel="icon" type="image/svg+xml" href="/favicon.svg"/><link rel="canonical" href="https://youple.tv/"/></head>
<body class="home-page" data-signed-in={String(!!user)}>
  <div class="playground-background" aria-hidden="true"><span></span><span></span><span></span><i class="bg-dot dot-one"></i><i class="bg-dot dot-two"></i><i class="bg-dot dot-three"></i><i class="bg-spark"><Icon name="spark" size={32}/></i></div>
  <main class="home-main">
    <section class="hangout" aria-labelledby="hero-title">
      <div class="hangout-heading reveal"><h1 id="hero-title"><Wordmark variant="hero"/></h1><p>Watch YouTube videos together in sync.</p></div>
      <div class="room-launcher reveal delay-1">
        <form id="create-form"><button class="primary-button wide create-room-button" type="submit"><span>Create room</span></button><div id="create-message" class="form-message" role="status"></div></form>
        <div class="launcher-footer"><span class="sync-presence"><i aria-hidden="true"></i><span id="sync-count">{illustrativeSyncCount()}</span> in sync</span><div class="launcher-account">{user ? <><span class="signed-avatar" title={name} aria-label={name}>{name?.slice(0,1)}</span><button class="account-launcher" type="button" data-sign-out>Sign out</button></> : <button class="account-launcher" type="button" data-sign-in>Sign in</button>}</div></div>
      </div>
      <div class="mascot-cast" aria-hidden="true"><div class="cast-member cast-mint"><span class="speech-bubble">Got a good video?</span><Mascot kind="mint"/><span class="cast-floor"></span></div><div class="cast-member cast-pink"><span class="speech-bubble">I brought snacks.</span><Mascot kind="pink"/><span class="cast-floor"></span></div><div class="cast-member cast-purple"><span class="speech-bubble">6-7</span><Mascot kind="purple"/></div><span class="floating-popcorn"><svg width="65" height="75" viewBox="0 0 65 75" fill="none"><path d="m9 31 7 39h33l7-39H9Z" fill="#F7EBCA"/><path d="m21 32 3 38h7l-1-38m9 0-2 38h7l4-38" fill="#EC8FA3"/><path d="M7 33c-7-10 2-19 10-13-2-16 17-19 21-8 12-7 22 5 14 14 12-2 14 9 6 13H9Z" fill="#FFF5D8"/></svg></span><MusicFlourishes/></div>
    </section>
    {user && <section class="saved-rooms" aria-labelledby="saved-title"><div class="saved-heading"><h2 id="saved-title">Your rooms</h2><button class="soft-button" type="button" data-create-room="member"><Icon name="plus" size={20}/>New saved room</button></div>{rooms.length ? <div class="saved-grid">{rooms.map(room => <a class="saved-room" href={'/room/'+room.slug}><Icon name="people" size={25}/><span><strong>{room.title}</strong><span>Open room</span></span></a>)}</div> : <p class="muted">Create a saved room and it will be waiting here next time.</p>}</section>}
    <section class="how-it-works reveal delay-2" aria-labelledby="how-title"><h2 id="how-title">Less “3, 2, 1, play!”<br/>More actually watching.</h2><div class="how-grid"><article><span class="step-symbol step-lilac"><Icon name="plus" size={28}/></span><h3>Make a room</h3><p>One click. No account needed.</p></article><article><span class="step-symbol step-pink"><Icon name="link" size={28}/></span><h3>Send the link</h3><p>Invite link copied. Paste it in your group chat.</p></article><article><span class="step-symbol step-mint"><Icon name="play" size={28}/></span><h3>Watch together</h3><p>Paste a YouTube link. Play, pause and skip in sync.</p></article></div></section>
    <section class="regular-room"><div class="regular-doodle" aria-hidden="true"><Icon name="people" size={39}/></div><div><h2>The same gang next time?</h2><p>Saved rooms live in your account. Sign in with Google, Discord or an email link.</p></div><button class="soft-button" type="button" data-create-room="member">Make a saved room</button></section>
    <details class="home-faq"><summary>Do we all control the video?</summary><p>Yep. Everyone in the room can play, pause, seek, skip and add videos. Volume stays on your own device. Some YouTube videos don't allow embedding; if one won't play, try the next one.</p></details>
  </main>
  <footer class="page-footer"><span>youple.tv</span><span>Watch together. Snacks optional.</span></footer>
  <div id="room-portal" class="room-portal" hidden aria-hidden="true"><div class="portal-tunnel">{Array.from({length:6},(_,i)=><span class="portal-ring" style={'--phase:'+i}></span>)}{Array.from({length:14},(_,i)=><span class="portal-streak" style={'--angle:'+(i*360/14)+'deg;--phase:'+(i%4)}></span>)}<div class="portal-core"><PortalIcon size={88}/></div></div></div>
  <AuthDialog configured={configured}/>
  <dialog id="saved-room-dialog" class="dialog" aria-labelledby="saved-room-heading"><button class="dialog-close" type="button" data-close-dialog aria-label="Close saved room"><Icon name="close" size={20}/></button><h2 id="saved-room-heading">Your regular hangout.</h2><p>Keep a room in your account for next time.</p><form id="saved-room-form"><label for="saved-room-title">Room name (optional)</label><input id="saved-room-title" name="title" placeholder="Movie night" maxlength="64" autocomplete="off"/><button class="primary-button wide" type="submit"><span>Create saved room</span></button><div id="saved-room-message" class="form-message" role="status"></div></form></dialog>
  <dialog id="join-dialog" class="dialog compact-dialog" aria-labelledby="join-heading"><button class="dialog-close" type="button" data-close-dialog aria-label="Close join room"><Icon name="close" size={20}/></button><h2 id="join-heading">Join room</h2><form id="join-form"><label class="sr-only" for="room-code">Room link or code</label><input id="room-code" name="room" placeholder="Room link or code" required autocomplete="off"/><button class="primary-button wide" type="submit">Join</button><div id="join-message" class="form-message" role="status"></div></form></dialog>
  <script>import { bootHome } from '../scripts/home-client.js'; bootHome();</script>
</body></html>
