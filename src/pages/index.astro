---
import Icon from '../components/Icon.astro';
import PortalIcon from '../components/PortalIcon.astro';
import Mascot from '../components/Mascot.astro';
import CatUniverse from '../components/CatUniverse.astro';
import MusicFlourishes from '../components/MusicFlourishes.astro';
import AuthDialog from '../components/AuthDialog.astro';
import Wordmark from '../components/Wordmark.astro';
import SiteFooter from '../components/SiteFooter.astro';
import '../styles/app.css';
import '../styles/home.css';
import { verifiedUser, displayName, avatarUrl } from '../lib/auth';
import { accountRooms } from '../lib/rooms';
import { illustrativeSyncCount } from '../lib/activity.js';
import { extensionListed } from '../lib/extension';
// Supabase falls back to the Site URL when a redirect URL isn't allowlisted.
const code = Astro.url.searchParams.get('code');
if (code) return Astro.redirect('/auth/callback?code=' + encodeURIComponent(code), 303);
const user = await verifiedUser(Astro);
const name = user ? displayName(user) : null;
const avatar = user ? avatarUrl(user) : null;
const configured = !!Astro.locals.runtime.env.SUPABASE_URL && !!Astro.locals.runtime.env.SUPABASE_PUBLISHABLE_KEY;
const rooms = user ? await accountRooms(Astro.locals.runtime.env, user.id) : [];
Astro.response.headers.set('Cache-Control', 'private, no-store');
---
<!doctype html>
<html lang="en">
<head><script is:inline>
  // The entrance animation plays once per visit, not every time someone comes back to the home page.
  try { if (sessionStorage.getItem("youple-home-seen")) document.documentElement.classList.add("home-seen"); sessionStorage.setItem("youple-home-seen", "1"); } catch {}
</script><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="description" content="Watch YouTube with your friends. Create a room, share the link, and press play together on youple.tv."/><meta name="theme-color" content="#181622"/><title>youple.tv — Watch YouTube together</title><link rel="icon" type="image/svg+xml" href="/favicon.svg"/><link rel="canonical" href="https://youple.tv/"/></head>
<body class="home-page" data-signed-in={String(!!user)}>
  <div class="playground-background" aria-hidden="true"><span></span><span></span><span></span><i class="bg-dot dot-one"></i><i class="bg-dot dot-two"></i><i class="bg-dot dot-three"></i><i class="bg-spark"><Icon name="spark" size={32}/></i></div>
  <main class="home-main">
    <section class="hangout" aria-labelledby="hero-title">
      <div class="hangout-heading reveal"><h1 id="hero-title"><Wordmark variant="hero"/></h1><p>Watch YouTube videos together in sync.</p></div>
      {user ? <div class="room-launcher member-launcher reveal delay-1">
        <div class="member-top"><a class="member-hello" href="/profile"><span class="signed-avatar">{avatar ? <img src={avatar} alt="" referrerpolicy="no-referrer"/> : name?.slice(0,1)}</span><span><strong>Hey, {name}</strong><span>Edit profile</span></span></a><button class="member-sign-out" type="button" data-sign-out>Sign out</button></div>
        <form id="create-form"><button class="primary-button wide create-room-button" type="submit"><span>Create quick room</span></button><div id="create-message" class="form-message" role="status"></div></form>
        <section class="member-rooms" aria-labelledby="saved-title">
          <div class="member-rooms-head"><h2 id="saved-title">Your rooms</h2><button class="member-add" type="button" data-create-room="member">Create permanent room</button></div>
          {rooms.length ? <ul>{rooms.map(room => <li><a href={'/room/'+room.slug}><Icon name="people" size={20}/><strong>{room.title}</strong><span>{room.joined ? 'Joined' : 'Open'}</span></a></li>)}</ul> : <p>Permanent rooms keep the same link, so your group can come back anytime.</p>}
        </section>
        <div class="launcher-footer"><span class="sync-presence"><i aria-hidden="true"></i><span id="sync-count">{illustrativeSyncCount()}</span> in sync</span></div>
      </div> : <div class="room-launcher reveal delay-1">
        <form id="create-form"><button class="primary-button wide create-room-button" type="submit"><span>Create room</span></button><div id="create-message" class="form-message" role="status"></div></form>
        <div class="launcher-footer"><span class="sync-presence"><i aria-hidden="true"></i><span id="sync-count">{illustrativeSyncCount()}</span> in sync</span><div class="launcher-account"><button class="account-launcher" type="button" data-sign-in>Sign in</button></div></div>
      </div>}
      <div class="mascot-cast"><div class="cast-member cast-black"><Mascot kind="black"/></div><span class="floating-popcorn" aria-hidden="true"><svg width="65" height="75" viewBox="0 0 65 75" fill="none"><path d="m9 31 7 39h33l7-39H9Z" fill="#F7EBCA"/><path d="m21 32 3 38h7l-1-38m9 0-2 38h7l4-38" fill="#EC8FA3"/><path d="M7 33c-7-10 2-19 10-13-2-16 17-19 21-8 12-7 22 5 14 14 12-2 14 9 6 13H9Z" fill="#FFF5D8"/></svg></span><MusicFlourishes/></div>
    </section>
    {!user && <>
    <section class="how-it-works reveal delay-2" aria-labelledby="how-title"><h2 id="how-title">Less “3, 2, 1, play!”<br/>More actually watching.</h2><div class="how-grid"><article><span class="step-symbol step-lilac"><Icon name="plus" size={28}/></span><h3>Make a room</h3><p>One click. No account needed.</p></article><article><span class="step-symbol step-pink"><Icon name="link" size={28}/></span><h3>Send the link</h3><p>Invite link copied. Paste it in your group chat.</p></article><article><span class="step-symbol step-mint"><Icon name="play" size={28}/></span><h3>Watch together</h3><p>Paste a YouTube link. Play, pause and skip in sync.</p></article></div></section>
    </>}
    <section class="faq-list" aria-label="Frequently asked questions">
      <div class="faq-column">
      <details class="home-faq"><summary>Quick room or permanent room?</summary><p>A quick room needs no account and closes after 30 days without visitors. A permanent room needs you to sign in, keeps the same link and stays until you delete it.</p></details>
      <details class="home-faq"><summary>How do my friends join?</summary><p>Your invite link is copied when you create a room. Send it to your friends, or tap Invite friends to copy it again. Permanent rooms ask friends to sign in too.</p></details>
      <details class="home-faq"><summary>Do we all control the video?</summary><p>Yep. Everyone can add videos, play, pause, seek and skip. Volume stays on your own device.</p></details>
      <details class="home-faq"><summary>Can I remove someone from my room?</summary><p>Yes, if you made the room. Open Watching and tap × next to their name. They stay out until you let them back in. You can delete a permanent room from the same panel or your profile.</p></details>
      </div>
      <div class="faq-column">
      <details class="home-faq"><summary>How do I add a video?</summary><p>Paste a YouTube link into the playlist. On desktop, Ctrl+V or Cmd+V also adds it without clicking the input.{extensionListed() && <> Or send videos straight from YouTube with our <a href="/extension">Chrome extension</a>.</>}</p></details>
      <details class="home-faq"><summary>Can we watch on phones?</summary><p>Yes. Open the room link in your browser. If playback needs a tap, choose Join playback.</p></details>
      <details class="home-faq"><summary>Why won’t a video play?</summary><p>Some YouTube videos can’t play outside YouTube. Try another video.</p></details>
      <details class="home-faq"><summary>Is it free?</summary><p>Yes, with no ads or tracking of our own. Videos play in YouTube’s player, so YouTube’s ads can still appear there.</p></details>
      </div>
    </section>
  </main>
  <SiteFooter/>
  <CatUniverse/>
  <div id="room-portal" class="room-portal" hidden aria-hidden="true"><div class="portal-tunnel">{Array.from({length:6},(_,i)=><span class="portal-ring" style={'--phase:'+i}></span>)}{Array.from({length:14},(_,i)=><span class="portal-streak" style={'--angle:'+(i*360/14)+'deg;--phase:'+(i%4)}></span>)}<div class="portal-core"><PortalIcon size={88}/></div></div></div>
  <AuthDialog configured={configured}/>
  <dialog id="saved-room-dialog" class="dialog" aria-labelledby="saved-room-heading"><button class="dialog-close" type="button" data-close-dialog aria-label="Close saved room"><Icon name="close" size={20}/></button><h2 id="saved-room-heading">Your regular hangout.</h2><p>Same link every time. It stays until you delete it.</p><form id="saved-room-form"><label for="saved-room-title">Room name (optional)</label><input id="saved-room-title" name="title" placeholder="Movie night" maxlength="64" autocomplete="off"/><button class="primary-button wide" type="submit"><span>Create permanent room</span></button><div id="saved-room-message" class="form-message" role="status"></div></form></dialog>
  <dialog id="join-dialog" class="dialog compact-dialog" aria-labelledby="join-heading"><button class="dialog-close" type="button" data-close-dialog aria-label="Close join room"><Icon name="close" size={20}/></button><h2 id="join-heading">Join room</h2><form id="join-form"><label class="sr-only" for="room-code">Room link or code</label><input id="room-code" name="room" placeholder="Room link or code" required autocomplete="off"/><button class="primary-button wide" type="submit">Join</button><div id="join-message" class="form-message" role="status"></div></form></dialog>
  <script>import { bootHome } from '../scripts/home-client.js'; bootHome();</script>
</body></html>
