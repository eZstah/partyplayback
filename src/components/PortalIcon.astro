---
interface Props { size?: number; class?: string }
const { size = 38, class: className = '' } = Astro.props;
---
<svg class:list={['portal-icon', className]} width={size} height={size} viewBox="0 0 40 40" fill="none" aria-hidden="true">
  <g class="portal-orbits" stroke="currentColor" stroke-width="1.8"><ellipse cx="20" cy="20" rx="17" ry="10" transform="rotate(-35 20 20)"/><ellipse cx="20" cy="20" rx="17" ry="10" transform="rotate(35 20 20)" opacity=".45"/><circle cx="33" cy="10" r="3" fill="currentColor" stroke="none"/></g>
  <rect x="12" y="12" width="16" height="16" rx="6" fill="currentColor"/>
  <path d="M17 18v4m6-4v4" stroke="#E9DEFF" stroke-width="2.4" stroke-linecap="round"/>
</svg>
