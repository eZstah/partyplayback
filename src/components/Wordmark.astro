---
interface Props { variant?: 'hero' | 'compact' }
const { variant = 'compact' } = Astro.props;
---
<span class:list={['youple-wordmark', { 'hero-wordmark': variant === 'hero' }]}>youple<span class="youple-tld">.tv</span></span>
<style>
  .youple-wordmark { position: relative; display: inline-block; font-family: Atkinson,Arial,sans-serif; font-weight: 700; letter-spacing: -.085em; line-height: 1.1; white-space: nowrap; color: #f6f2ef; }
  .youple-tld { color: #c3afff; }
</style>
