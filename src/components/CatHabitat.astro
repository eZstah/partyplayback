---
import '../styles/cat-habitat.css';
// Bean's room for Aquarium mode. Furniture marked data-perch becomes a surface in
// the cat engine (see docs/bean/ARCHITECTURE.md, "Aquarium furniture"):
// "solid" pieces can be climbed, sat on, hidden behind and peeked over;
// "shelf" pieces are platforms to jump onto. data-toy items can be knocked about.
// The window follows the visitor's time of day and the weather changes now and
// then (src/scripts/habitat-scene.js). In a room, the real player sits in the TV.
// Fairy lights sag between four hooks along the top of the wall.
const sag = (x: number) => 6 + 26 * Math.sin(Math.PI * ((x % 250) / 250));
const garland = Array.from({ length: 101 }, (_, i) => `${i ? 'L' : 'M'}${i * 10} ${sag(i * 10).toFixed(1)}`).join('');
const bulbs = Array.from({ length: 24 }, (_, i) => { const x = (i + .5) * 1000 / 24; return { x, y: sag(x) + 6, tone: i % 4 }; });
---
<div class="cat-habitat" aria-hidden="true" data-daypart="dusk" data-weather="clear">
  <div class="habitat-wall"></div>
  <div class="habitat-boards"></div><div class="habitat-rug"></div>
  <div class="habitat-sunbeam"></div>
  <svg class="habitat-garland" viewBox="0 0 1000 50" preserveAspectRatio="none"><path d={garland} fill="none" stroke="#5b4a60" stroke-width="1.4" vector-effect="non-scaling-stroke"/>{bulbs.map(b => <ellipse class={`bulb b${b.tone}`} cx={b.x} cy={b.y} rx="3.2" ry="4.4"/>)}</svg>
  <div class="habitat-sign"><strong>youple.tv</strong><span>Bean lives here. you’re visiting.</span></div>

  <div class="prop prop-window">
    <div class="window-sky">
      <div class="sky-stars"></div><div class="sky-sun"></div><div class="habitat-moon"></div>
      <div class="sky-clouds"><span></span><span></span><span></span></div>
      <svg class="sky-city" viewBox="0 0 300 70" preserveAspectRatio="none"><path d="M0 70V44h18V30h14v12h10V22h22v26h12V36h16V14h18v34h10V40h20V26h14v22h12V32h20v16h10V18h24v30h14V38h16V28h16v42Z"/><g class="city-lights">{Array.from({length:22},(_,i)=><rect x={(i*53+11)%290} y={30+(i*17)%32} width="3" height="4"/>)}</g></svg>
      <div class="sky-rain"></div>
    </div>
    <div class="window-glass"></div>
    <div class="window-curtain left"></div><div class="window-curtain right"></div>
    <div class="window-sill" data-perch="shelf" data-nap><span class="sill-pot"></span></div>
  </div>
  <div class="prop wall-shelf" data-perch="shelf"><span class="shelf-lamp"></span><span class="wall-shelf-cup"></span></div>

  <div class="prop prop-tree">
    <div class="tree-post"></div>
    <div class="tree-cubby" data-perch="solid" data-nap><span class="cubby-hole"></span></div>
    <div class="tree-deck deck-low" data-perch="shelf"></div>
    <div class="tree-deck deck-mid" data-perch="shelf"><span class="deck-pompom"></span></div>
    <div class="tree-bed" data-perch="shelf" data-nap></div>
  </div>

  <svg class="habitat-plant" viewBox="0 0 150 280"><g fill="none" stroke="#aca0bf" stroke-width="4" stroke-linecap="round"><path d="M78 215Q63 150 89 50M77 191Q103 135 128 122M76 164Q39 129 23 93"/></g><g fill="#8f9f91"><ellipse cx="88" cy="63" rx="14" ry="36" transform="rotate(16 88 63)"/><ellipse cx="35" cy="109" rx="14" ry="35" transform="rotate(-40 35 109)"/><ellipse cx="112" cy="140" rx="14" ry="35" transform="rotate(38 112 140)"/></g><path d="m48 210 9 63h46l11-63Z" fill="#c69f9e"/><ellipse cx="81" cy="210" rx="33" ry="7" fill="#dbb3b0"/></svg>

  <div class="prop prop-sofa">
    <div class="sofa-back" data-perch="solid" data-view></div>
    <div class="sofa-seat" data-perch="solid" data-nap data-view><span class="sofa-cushion"></span><span class="sofa-cushion"></span></div>
    <div class="sofa-arm left"></div><div class="sofa-arm right"></div>
    <span class="sofa-blanket"></span>
  </div>

  <div class="prop prop-box" data-perch="solid" data-nap data-view><span class="box-flap left"></span><span class="box-flap right"></span><span class="box-label">BEAN · this side up</span></div>
  <span class="prop yarn" data-toy></span>

  <!-- The TV hangs over a low console. In a room, the player is placed over .tv-screen. -->
  <div class="prop console" data-perch="shelf" data-view><span class="drawer"></span><span class="drawer"></span><span class="console-speaker"></span></div>
  <div class="prop tv" data-perch="solid"><div class="tv-screen"><span>youple.tv</span></div><span class="tv-led"></span></div>

  <div class="prop prop-books" data-perch="solid">
    <div class="books row-1"></div><div class="books row-2"></div><div class="books row-3"></div>
    <div class="book-shelf" data-perch="shelf"></div>
  </div>
  <span class="prop toy-mouse" data-toy></span>
  <div class="habitat-light"></div>
</div>
<script>
  import { mountScene } from '../scripts/habitat-scene.js';
  const habitat = document.querySelector('.cat-habitat');
  if (habitat instanceof HTMLElement) mountScene(habitat);
</script>
