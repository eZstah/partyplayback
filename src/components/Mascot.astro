---
import '../styles/mascot.css';
import CatExpression from './CatExpression.astro';
import { CAT_NAMES, faceFor } from '../scripts/cat-reactions.js';
interface Props { kind?: 'mint' | 'pink' | 'purple'; class?: string; interactive?: boolean }
const { kind = 'mint', class: className = '', interactive = false } = Astro.props;
const Tag = interactive ? 'button' : 'div';
---
<Tag class:list={['mascot', kind, className]} data-kind={kind} data-reaction="idle" data-face={faceFor(kind)}
  type={interactive ? 'button' : undefined} aria-label={interactive ? `Pet ${CAT_NAMES[kind]}` : undefined}
  aria-hidden={interactive ? undefined : 'true'}>
  <span class="mascot-rig">
    <svg class="cat-art" viewBox="0 0 180 210" fill="none" aria-hidden="true" focusable="false">
      <ellipse class="cat-ground" cx="91" cy="199" rx="56" ry="6"/>
      <g class="cat-motion">
      <g class="cat-body">
        <path class="cat-tail" d="M128 180c40 11 42-31 25-34-12-2-16 14-7 19"/>
        <path class="cat-fur cat-outline" d="M55 117c-10 19-14 49-9 67 5 15 24 13 43 13 23 0 43 3 48-15 5-19-3-45-14-64Z"/>
        <path class="cat-bib" d="M73 130c-10 15-17 36-13 51 4 13 47 13 53 0 5-14-4-38-14-51Z"/>
        <g class="cat-feet cat-outline">
          <g class="cat-foot-left"><path class="cat-fur" d="M51 180c-11 0-14 16-3 18h22c9-2 8-13 2-17"/><path class="cat-detail" d="m52 189-1 6m9-5v6"/></g>
          <g class="cat-foot-right"><path class="cat-fur" d="M108 182c-9 3-8 14 1 16h21c12-3 6-18-3-18"/><path class="cat-detail" d="m115 190v6m9-7 1 6"/></g>
        </g>
        <path class="cat-collar" d="M59 130q30 16 61-1l-3 12q-28 12-55-1Z"/>
        <g class="cat-tag"><circle cx="90" cy="145" r="8"/><path d="m88 141 6 4-6 4Z"/></g>
        <g class="cat-snack">
          <path d="m68 161 6 30h32l6-30Z" fill="#FFF0CA" stroke="#664957" stroke-width="2.5" stroke-linejoin="round"/>
          <path d="m78 163 3 26m10-26v26m12-26-3 26" stroke="#E79CAA" stroke-width="6"/>
          <path d="M68 162c-9-5-3-17 5-13-4-13 11-18 16-8 7-11 20-4 17 5 11-1 16 11 7 17Z" fill="#FFF5D8" stroke="#664957" stroke-width="2.5"/>
          <path d="m80 151 4 1m10-6-1 4m10 5-3 1" stroke="#E5BA73" stroke-width="3" stroke-linecap="round"/>
        </g>
      </g>
      <g class="cat-head">
        <g class="cat-ear cat-ear-left">
          <path class="cat-fur cat-outline" d="M29 68 24 20q0-7 7-3l38 29Z"/>
          <path class="cat-ear-inner" d="m36 53-4-25 23 22Z"/>
        </g>
        <g class="cat-ear cat-ear-right">
          <path class="cat-fur cat-outline" d="m111 44 36-27q7-4 7 4l-3 48Z"/>
          <path class="cat-ear-inner" d="m126 50 21-21-3 26Z"/>
        </g>
        <path class="cat-fur cat-outline" d="M88 37c-35-1-62 16-65 42l-5 12 7 1-4 10 9-1c8 28 36 38 60 38 27 0 54-9 61-35l10-5-8-7 7-6-10-5c-3-28-28-44-62-44Z"/>
        <path class="cat-forehead" d="m70 39 7 16 8-8 8 11 11-18"/>
        <path class="cat-muzzle" d="M89 88c-8 0-11 11-19 14-17 7-14 26 4 30 11 3 22 3 33-1 17-6 18-24 1-29-9-3-12-14-19-14Z"/>
        <g class="cat-blush"><ellipse cx="46" cy="101" rx="11" ry="5"/><ellipse cx="133" cy="101" rx="11" ry="5"/></g>
        <g class="cat-whiskers"><path d="m19 92 20 4m-24 7 22-1m105-6 20-5m-19 12 22 1"/></g>
        <g class="cat-face"><CatExpression/></g>
      </g>
        <g class="cat-arm cat-arm-left"><path class="cat-fur cat-outline" d="M55 136c-10 7-15 26-10 35 3 7 13 4 15-3l7-24"/><path class="cat-detail" d="m49 165 2 4m4-5 1 4"/></g>
        <g class="cat-arm cat-arm-right"><path class="cat-fur cat-outline" d="M123 135c11 8 16 25 11 34-4 8-14 4-16-3l-7-24"/><path class="cat-detail" d="m129 161-2 5m-4-5-1 4"/></g>
      <g class="cat-delight"><path d="M19 48v12m-6-6h12m137 51v10m-5-5h10"/><path d="m154 29 2 6 6 2-6 2-2 6-2-6-6-2 6-2Z"/></g>
      </g>
    </svg>
  </span>
</Tag>
