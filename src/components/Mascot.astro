---
import '../styles/mascot.css';
interface Props { kind?: 'mint' | 'pink' | 'purple'; class?: string }
const { kind = 'mint', class: className = '' } = Astro.props;
---
<div class:list={['mascot', kind, className]} data-kind={kind} aria-hidden="true">
  <div class="mascot-shadow"></div>
  <div class="mascot-rig">
  <div class="mascot-arm arm-left"></div><div class="mascot-arm arm-right"></div>
  <div class="mascot-foot foot-left"></div><div class="mascot-foot foot-right"></div>
  <div class="mascot-body">
    {kind === 'mint' && <svg class="mascot-scarf" viewBox="0 0 100 60" fill="none"><path d="M8 8q42 16 84 0l-8 19q-34 11-68-1Z" fill="#F5B964"/><path d="m67 23 18 4-3 30-15-6-5-26Z" fill="#DB8B45"/><path d="m68 30 15 5m-16 7 15 5" stroke="#FFD895" stroke-width="3"/><ellipse cx="68" cy="22" rx="10" ry="8" fill="#FFC976"/></svg>}
    {kind === 'purple' && <>
      <svg class="mascot-vest" viewBox="0 0 100 55" fill="none"><path d="m10 5 22-5 18 28L68 0l22 5 6 42q-46 16-92 0Z" fill="#467A93"/><path d="m32 0 18 28 18-28M50 28v25" stroke="#A9CED6" stroke-width="4"/><path d="M18 31h17v12H18z" fill="#A9CED6"/><circle cx="64" cy="36" r="3" fill="#F5CB7E"/></svg>
      <svg class="mascot-beanie" viewBox="0 0 100 65" fill="none"><circle cx="50" cy="9" r="9" fill="#F5BE70"/><path d="M12 50C10 4 90 4 88 50Z" fill="#E69B4E"/><path d="M32 18q-5 15-5 31m23-34v34m18-31q5 15 5 31" stroke="#F5BE70" stroke-width="4" stroke-linecap="round"/><rect x="7" y="42" width="86" height="20" rx="9" fill="#F5BE70"/><rect x="43" y="46" width="15" height="12" rx="3" fill="#FFF0CD"/></svg>
    </>}
    {kind === 'pink' && <>
      <svg class="mascot-headphones" viewBox="0 0 100 100" fill="none"><path d="M9 58V40C9-4 91-4 91 40v18" stroke="#6557A4" stroke-width="10" stroke-linecap="round"/><path d="M14 37C14 2 86 2 86 37" stroke="#C5B1F4" stroke-width="5" stroke-linecap="round"/><rect x="0" y="46" width="18" height="35" rx="9" fill="#8D7AC8"/><rect x="82" y="46" width="18" height="35" rx="9" fill="#8D7AC8"/><rect x="8" y="50" width="10" height="27" rx="5" fill="#D6C8FF"/><rect x="82" y="50" width="10" height="27" rx="5" fill="#D6C8FF"/></svg>
      <svg class="mascot-flower" viewBox="0 0 40 40" fill="none"><path d="M20 11C7-6-4 15 12 20-4 25 7 46 20 29c13 17 24-4 8-9 16-5 5-26-8-9Z" fill="#FFF0CC"/><circle cx="20" cy="20" r="7" fill="#E7AB4C"/></svg>
    </>}
    <div class="mascot-face"><span class="mascot-eye"><i></i></span><span class="mascot-eye"><i></i></span><svg class="mascot-mouth" width="38" height="21" viewBox="0 0 38 21" fill="none"><path d="M5 5c3 14 25 14 28 0" stroke="currentColor" stroke-width="4" stroke-linecap="round"/></svg><span class="mascot-mouth-o"></span><span class="cheek cheek-left"></span><span class="cheek cheek-right"></span>
      {kind === 'mint' && <svg class="mascot-glasses" viewBox="0 0 100 44" fill="none"><path d="M0 17h12m76 0h12M47 20q3-5 6 0" stroke="#4A3A5B" stroke-width="4" stroke-linecap="round"/><circle cx="30" cy="20" r="17" fill="#FDF8E518" stroke="#4A3A5B" stroke-width="4"/><circle cx="70" cy="20" r="17" fill="#FDF8E518" stroke="#4A3A5B" stroke-width="4"/><path d="m20 11 6-3m34 3 6-3" stroke="#FFF8EE" stroke-width="3" stroke-linecap="round"/></svg>}
    </div>
  </div>
  </div>
</div>
