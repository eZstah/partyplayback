---
import Mascot from './Mascot.astro';
import { CAST } from '../scripts/cat-director.js';
import '../styles/cat-universe.css';
---
<div id="cat-universe" hidden>
  <div class="cat-habitat" aria-hidden="true">
    <div class="habitat-halo"></div><div class="habitat-moon"></div>
    <svg class="habitat-stars" viewBox="0 0 1440 900" preserveAspectRatio="xMidYMid slice"><g fill="#e8dff5">{Array.from({length:38},(_,i)=><circle cx={(i*337+41)%1440} cy={(i*127+39)%680} r={i%4===0?2:1} opacity={.2+i%4*.13}/>)}</g><g stroke="#b7a0e4" stroke-width="1.5" fill="none"><path d="M1220 115v18m-9-9h18M208 221v12m-6-6h12M976 60v12m-6-6h12"/><path d="M99 450Q440 100 789 218T1430 170" opacity=".12"/></g></svg>
    <div class="habitat-floor"></div><div class="habitat-rug"></div>
    <svg class="habitat-plant" viewBox="0 0 150 280"><g fill="none" stroke="#aca0bf" stroke-width="4" stroke-linecap="round"><path d="M78 215Q63 150 89 50M77 191Q103 135 128 122M76 164Q39 129 23 93"/></g><g fill="#8f9f91"><ellipse cx="88" cy="63" rx="14" ry="36" transform="rotate(16 88 63)"/><ellipse cx="35" cy="109" rx="14" ry="35" transform="rotate(-40 35 109)"/><ellipse cx="112" cy="140" rx="14" ry="35" transform="rotate(38 112 140)"/></g><path d="m48 210 9 63h46l11-63Z" fill="#c69f9e"/><ellipse cx="81" cy="210" rx="33" ry="7" fill="#dbb3b0"/></svg>
    <div class="habitat-sign"><strong>youple.tv</strong><span>the cats live here. you’re visiting.</span></div>
  </div>
  <div id="cat-world" aria-label="The youple cats">
    {Object.entries(CAST).map(([kind, cat]) => <div class="sim-actor" data-cat={kind}><div class="sim-depth"><span class="sim-bubble" aria-hidden="true"></span><Mascot kind={kind as 'mint' | 'pink' | 'purple'} interactive/></div></div>)}
    <svg id="cat-scuffs" aria-hidden="true"><g id="cat-scratch-lines"></g></svg>
    <div id="cat-toy" aria-hidden="true"><svg viewBox="0 0 48 32"><path d="M32 17q18-15 11-12" fill="none" stroke="#e6c290" stroke-width="2"/><ellipse cx="21" cy="19" rx="15" ry="9" fill="#b8a3df"/><circle cx="15" cy="10" r="6" fill="#debbd1"/><circle cx="9" cy="19" r="2" fill="#42384e"/></svg></div>
    <div id="cat-impact" aria-hidden="true">✦</div>
  </div>
  <div class="cat-dock" data-awake="true">
    <div id="cat-studio" class="cat-studio" hidden>
      <div class="studio-heading"><div><strong>Three cats. One shared brain cell.</strong><p id="cat-story-label">Make yourself at home.</p></div><button type="button" id="cat-studio-close" aria-label="Close cat studio">×</button></div>
      <div class="cat-roster">{Object.entries(CAST).map(([kind,cat])=><div class:list={['cat-roster-item',kind]}><i></i><div><strong>{cat.name}<span>{cat.role}</span></strong><small data-cat-status={kind}>{cat.motive}</small></div></div>)}</div>
      <div class="cat-settings"><label>Energy<select id="cat-intensity"><option value="watch">Here for the video</option><option value="play" selected>Let them play</option><option value="chaos">Unsupervised</option></select></label><label>Video mood<select id="cat-vibe"><option value="auto">From the video title</option><option value="music">Music / energetic</option><option value="chill">Chill / sleepy</option><option value="talk">Talking / learning</option><option value="action">Action / gaming</option></select></label></div>
      <p id="cat-context-note" class="cat-context-note">Reactions use the video title and playback, not audio analysis.</p>
      <div class="cat-scene-actions"><button type="button" data-cat-scene="snack">Share popcorn</button><button type="button" id="cat-toy-btn" aria-pressed="false">Toy mouse</button><button type="button" data-cat-scene="peek">Break the fourth wall</button><button type="button" data-cat-scene="squabble">Start a squabble</button><button type="button" data-cat-scene="mischief">Knock things over</button><button type="button" id="cat-reset">Everybody home</button></div>
      <p class="cat-studio-hint">Pet or drag a cat. Move the toy to lead a chase. Escape brings everyone home.</p>
    </div>
    <div class="cat-dock-bar"><button type="button" id="cat-studio-btn" aria-expanded="false" aria-controls="cat-studio"><span class="cat-dock-paw" aria-hidden="true">✦</span> Cat studio</button><button type="button" id="cat-wallpaper-btn" aria-pressed="false">Wallpaper</button><button type="button" id="cat-pause-btn" aria-pressed="false">Pause cats</button></div>
  </div>
</div>
