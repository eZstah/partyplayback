---
import { CAST } from '../scripts/cats/cast.js';
import '../styles/cat-universe.css';
---
<div id="cat-universe" hidden>
  <div class="cat-habitat" aria-hidden="true">
    <div class="habitat-halo"></div><div class="habitat-moon"></div>
    <svg class="habitat-stars" viewBox="0 0 1440 900" preserveAspectRatio="xMidYMid slice"><g fill="#e8dff5">{Array.from({length:38},(_,i)=><circle cx={(i*337+41)%1440} cy={(i*127+39)%680} r={i%4===0?2:1} opacity={.2+i%4*.13}/>)}</g><g stroke="#b7a0e4" stroke-width="1.5" fill="none"><path d="M1220 115v18m-9-9h18M208 221v12m-6-6h12M976 60v12m-6-6h12"/><path d="M99 450Q440 100 789 218T1430 170" opacity=".12"/></g></svg>
    <div class="habitat-floor"></div><div class="habitat-rug"></div>
    <svg class="habitat-plant" viewBox="0 0 150 280"><g fill="none" stroke="#aca0bf" stroke-width="4" stroke-linecap="round"><path d="M78 215Q63 150 89 50M77 191Q103 135 128 122M76 164Q39 129 23 93"/></g><g fill="#8f9f91"><ellipse cx="88" cy="63" rx="14" ry="36" transform="rotate(16 88 63)"/><ellipse cx="35" cy="109" rx="14" ry="35" transform="rotate(-40 35 109)"/><ellipse cx="112" cy="140" rx="14" ry="35" transform="rotate(38 112 140)"/></g><path d="m48 210 9 63h46l11-63Z" fill="#c69f9e"/><ellipse cx="81" cy="210" rx="33" ry="7" fill="#dbb3b0"/></svg>
    <div class="habitat-sign"><strong>youple.tv</strong><span>the cats live here. you’re visiting.</span></div>
  </div>
  <div id="cat-world"><canvas id="cat-canvas" aria-hidden="true"></canvas></div>
  <div class="cat-dock">
    <section id="cat-panel" class="cat-panel" aria-labelledby="cat-panel-title" hidden>
      <div class="cat-panel-head">
        <div><h2 id="cat-panel-title">The residents</h2><p>Four cats with their own moods, friendships and memory of you.</p></div>
        <button type="button" id="cat-panel-close" class="cat-panel-close" aria-label="Close">×</button>
      </div>
      <ul class="cat-cards">
        {Object.entries(CAST).map(([kind, cat]) => (
          <li class="cat-card" data-cat-card={kind} style={`--cat-fur:${cat.look.fur};--cat-collar:${cat.look.collar}`}>
            <span class="cat-swatch" aria-hidden="true"></span>
            <div>
              <h3>{cat.name} <span>{cat.role}</span></h3>
              <p class="cat-bio">{cat.bio}</p>
              <p class="cat-traits" data-traits></p>
              <dl>
                <div><dt>Now</dt><dd data-doing>Settling in</dd></div>
                <div><dt>Feels</dt><dd data-feels>calm</dd></div>
                <div><dt>Likes you</dt><dd data-trust class="cat-hearts">♡♡♡♡♡</dd></div>
                <div><dt>Friends</dt><dd data-bonds></dd></div>
              </dl>
              <p class="cat-thought" data-thought></p>
            </div>
          </li>
        ))}
      </ul>
      <div class="cat-actions">
        <button type="button" id="cat-treat-btn">Drop a treat</button>
        <button type="button" id="cat-laser-btn" aria-pressed="false">Laser pointer</button>
        <button type="button" id="cat-aquarium-btn" aria-pressed="false">Aquarium</button>
        <button type="button" id="cat-calm-dock" aria-pressed="false">Calm cats</button>
      </div>
      <h3 class="cat-journal-title">Cat diary</h3>
      <ol id="cat-journal" class="cat-journal"></ol>
      <p class="cat-hint">Stroke a cat with your cursor to pet it, click to boop, drag to pick it up. Double-click empty space to drop a treat.</p>
    </section>
    <button type="button" id="cat-panel-btn" class="cat-panel-btn" aria-expanded="false" aria-controls="cat-panel">
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><g fill="currentColor"><ellipse cx="12" cy="16" rx="5" ry="4"/><circle cx="6" cy="10" r="2.2"/><circle cx="18" cy="10" r="2.2"/><circle cx="9.3" cy="6" r="2.1"/><circle cx="14.7" cy="6" r="2.1"/></g></svg>
      <span>Cats</span>
    </button>
  </div>
</div>
