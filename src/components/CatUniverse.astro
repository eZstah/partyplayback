---
import '../styles/cat-universe.css';
import CatHabitat from './CatHabitat.astro';
---
<div id="cat-universe" hidden>
  <CatHabitat/>
  <div id="cat-world"><canvas id="cat-canvas" aria-hidden="true"></canvas></div>
  <div class="cat-dock">
    <section id="cat-panel" class="cat-panel" role="menu" aria-label="Bean" hidden>
      <button type="button" id="cat-hello-btn" role="menuitem" tabindex="-1">Come say hi</button>
      <button type="button" id="cat-treat-btn" role="menuitem" tabindex="-1">Give a treat</button>
      <button type="button" id="cat-laser-btn" role="menuitemcheckbox" aria-checked="false" tabindex="-1">Laser pointer</button>
      <button type="button" id="cat-calm-dock" role="menuitemcheckbox" aria-checked="false" tabindex="-1">Let Bean sleep</button>
    </section>
    <button type="button" id="cat-aquarium-btn" class="cat-aquarium-btn" aria-pressed="false">Aquarium</button>
    <button type="button" id="cat-panel-btn" class="cat-panel-btn" aria-label="Bean options" title="Bean options · or right-click Bean" aria-haspopup="menu" aria-expanded="false" aria-controls="cat-panel">
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><g fill="currentColor"><ellipse cx="12" cy="16" rx="5" ry="4"/><circle cx="6" cy="10" r="2.2"/><circle cx="18" cy="10" r="2.2"/><circle cx="9.3" cy="6" r="2.1"/><circle cx="14.7" cy="6" r="2.1"/></g></svg>
    </button>
  </div>
</div>
