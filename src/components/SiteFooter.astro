---
import { impressumReady } from '../lib/legal';
import { extensionListed } from '../lib/extension';
const links = [
  { href: '/about', label: 'About' },
  ...(extensionListed() ? [{ href: '/extension', label: 'Chrome extension' }] : []),
  { href: '/privacy', label: 'Privacy' },
  ...(impressumReady() ? [{ href: '/impressum', label: 'Impressum' }] : []),
  { href: '/contact', label: 'Contact' },
  { href: '/contact?type=bug', label: 'Report a bug' },
];
---
<footer class="site-footer">
  <a class="site-footer-brand" href="/">youple.tv</a>
  <nav aria-label="Site"><ul>{links.map(link => <li><a href={link.href}>{link.label}</a></li>)}</ul></nav>
  <p>Watch together. Snacks optional.</p>
</footer>
<style is:global>
  /* Pages with this footer crossfade into each other instead of flashing a full reload. Rooms opt out. */
  @media (prefers-reduced-motion: no-preference) { @view-transition { navigation: auto; } }
</style>
<style>
  .site-footer { display: grid; justify-items: center; gap: 12px; padding: 40px 16px 44px; text-align: center; color: #a39aac; font-size: 15px; }
  .site-footer-brand { font-weight: 700; font-size: 18px; letter-spacing: -.04em; color: var(--accent); }
  .site-footer ul { display: flex; flex-wrap: wrap; justify-content: center; gap: 6px 22px; list-style: none; margin: 0; padding: 0; }
  .site-footer ul a { color: #d0c8dc; }
  .site-footer ul a:hover { color: var(--ink); }
  .site-footer p { margin: 0; font-size: 14px; }
</style>
